# Copy to .env and uncomment what you need. `bun run dev` loads .env automatically.

# Where the library, settings, API keys and phone certificate live (default: ~/.murmur)
# MURMUR_DATA=/path/to/murmur-data

# Set to 1 to keep murmur to this Mac: no HTTPS door for phones, no QR code
# MURMUR_LOCAL=1

# Port for the fake TTS/STT provider (bun dev/fake-provider.ts; default: 8899)
# PORT=8899
